{
  "manifest_version": 2,
  "name": "FactoidL",
  "description": "Checks the accuracy of webpage content based on other web sources.",
  "version": "2.6.2",

  "icons": {  "16":  "FactoidL_Logo_Rounded_icon16_2.0_FINAL.png",
              "48":  "FactoidL_Logo_Rounded_icon48_2.0_FINAL.png",
              "128": "FactoidL_Logo_Rounded_icon128_2.0_FINAL.png" },

  "background": {
    "scripts": ["compromise.min.js", "factoidl-common.js", "jquery-3.4.1.min.js", "background.js"]
  },

  "browser_action": {
    "default_icon": "FactoidL_Logo_Rounded_icon48_2.0_FINAL.png",
    "default_popup": "popup.html",
    "default_title": "FactoidL"
  },

  "permissions": [
    "activeTab",
    "https://ajax.googleapis.com/",
    "https://*/",
    "*://*/*"
  ],

  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}
